<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ScamMobileApp.Views.More.AIImageCheckPage"
             BackgroundColor="{StaticResource PrimaryColor}"
             Title="AI Image Check">


    <StackLayout Margin="20">
        <Frame Padding="50" CornerRadius="10" BorderColor="#999999" Margin="0,40,0,0" HasShadow="False">
            <Frame.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding uploadImageCommand}"/>
            </Frame.GestureRecognizers>
            <StackLayout>
                <!--<Image Source="uploadImage.png" WidthRequest="100" HeightRequest="100"/>-->
                <Image Source="{Binding PImage}" HeightRequest="100" WidthRequest="100" Aspect="AspectFill" HorizontalOptions="CenterAndExpand">
                    
                </Image>
                <Label Text="Select Media file to upload" TextColor="Black" FontSize="16" HorizontalTextAlignment="Center" Margin="0,20,0,0"/>
            </StackLayout>
        </Frame>

        <Grid>
            <Frame Padding="20" BackgroundColor="White" CornerRadius="10" IsVisible="{Binding ShowText}" HasShadow="False">
                <StackLayout>
                    <Label Text="Detect AI-Generated images instantly." FontFamily="Airbnb-Bold" TextColor="Black" FontSize="14" HorizontalTextAlignment="Start" Margin="0,10,0,0"/>
                    <Label Text="With deepfake on the rise, verifying image authenticity is more crucial than ever. Our Image Detection tool tells you how likely your image has been generated by AI." TextColor="#333333" FontSize="13" HorizontalTextAlignment="Start" Margin="0,5,0,0"/>

                    <StackLayout>
                        <Label Text="How it Works:" TextColor="Black" FontFamily="Airbnb-Bold" FontSize="14" HorizontalTextAlignment="Start" Margin="0,10,0,0"/>
                        <StackLayout Orientation="Horizontal">
                            <Label HorizontalOptions="StartAndExpand" >
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="1. Input:" TextColor="#374352"  FontFamily="Airbnb-Bold" FontSize="14"/>

                                        <Span Text=" Upload an image" TextColor="#646C79" FontSize="14" FontFamily="Airbnb-Mediun" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                        </StackLayout>
                        <StackLayout Orientation="Horizontal">
                            <Label HorizontalOptions="StartAndExpand" >
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="2. Output:" TextColor="#374352"  FontFamily="Airbnb-Bold" FontSize="14"/>
                                        <Span Text=" A confidence score (%) indicating how likely an image has been generated by AI." TextColor="#646C79" FontSize="14" FontFamily="Airbnb-Mediun" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                        </StackLayout>

                    </StackLayout>
                </StackLayout>
            </Frame>

            <StackLayout Margin="0,10" IsVisible="{Binding ShowResult}">
                <Label Text="Check result is shown below: " TextColor="Black" FontSize="16" HorizontalTextAlignment="Start" Margin="0,20,0,0"/>
                <FlexLayout JustifyContent="SpaceBetween" AlignItems="Center" Margin="0,10">
                    <Label Text="Status: " TextColor="{StaticResource SecondaryColor}" FontSize="16" HorizontalTextAlignment="Start" Margin="0,5,0,0"/>

                    <Label Text="{Binding Status}" TextColor="{StaticResource SecondaryColor}" FontSize="16" HorizontalTextAlignment="Start" Margin="0,5,0,0"/>
                </FlexLayout>
                <Line X1="0"
                Y1="0"
                X2="400"
                Y2="0"
                Stroke="#D7D7D7" />

                <FlexLayout JustifyContent="SpaceBetween" AlignItems="Center" Margin="0,10">
                    <Label Text="AI Generated: " TextColor="{StaticResource SecondaryColor}" FontSize="16" HorizontalTextAlignment="Start" Margin="0,5,0,0"/>

                    <Label Text="{Binding AiGenerated}" TextColor="{StaticResource SecondaryColor}" FontSize="16" HorizontalTextAlignment="Start" Margin="0,5,0,0"/>
                </FlexLayout>
                <Line X1="0"
                    Y1="0"
                    X2="400"
                    Y2="0"
                    Stroke="#D7D7D7" />

                <FlexLayout JustifyContent="SpaceBetween" AlignItems="Center" Margin="0,10">
                    <Label Text="Timestamp: " TextColor="{StaticResource SecondaryColor}" FontSize="16" HorizontalTextAlignment="Start" Margin="0,5,0,0"/>

                    <Label Text="{Binding Timestamp}" TextColor="{StaticResource SecondaryColor}" FontSize="16" HorizontalTextAlignment="Start" Margin="0,5,0,0"/>
                </FlexLayout>
                <Line X1="0"
                Y1="0"
                X2="400"
                Y2="0"
                Stroke="#D7D7D7" />
            </StackLayout>

        </Grid>
    </StackLayout>
</ContentPage>